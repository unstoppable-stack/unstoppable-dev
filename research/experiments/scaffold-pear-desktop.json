{
  "id": "scaffold-pear-desktop",
  "name": "Pear Desktop Scaffold Validation",
  "description": "Verify that scaffolded Pear Desktop projects install, have valid JS, and the app launches without crashing",

  "build": {
    "command": "npx tsup src/us.ts --format esm && npm install -g .",
    "cwd": "packages/cli"
  },

  "output": "research/results/scaffold-pear-desktop",

  "variants": [
    {
      "name": "features",
      "values": ["bare", "p2p", "kv-storage", "qvac", "autobase", "p2p,qvac", "p2p,kv-storage", "p2p,kv-storage,qvac,autobase"]
    }
  ],

  "workDir": "/tmp/us-research-{{id}}-{{features_slug}}",

  "setup": [
    {
      "name": "clean",
      "command": "rm -rf /tmp/us-research-{{id}}-{{features_slug}}",
      "optional": true
    },
    {
      "name": "scaffold",
      "command": "us scaffold app -p pear-desktop -n test-pear {{features_flag}} -o /tmp/us-research-{{id}}-{{features_slug}} --force",
      "timeout": 10000
    },
    {
      "name": "npm-install",
      "command": "npm install",
      "timeout": 120000
    }
  ],

  "measure": [
    {
      "name": "package-json-valid",
      "command": "node -e \"const p = require('./package.json'); if (!p.name || !p.pear) throw new Error('missing pear config')\"",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "index-html-exists",
      "command": "test -f index.html",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "worker-js-syntax",
      "command": "node --check worker.js",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "index-js-syntax",
      "command": "node --check index.js",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "app-js-syntax",
      "command": "node --check app/index.js",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "pear-runtime-smoke",
      "mode": "spawn",
      "command": "pear run --dev .",
      "expectedOutput": ["worker-ready"],
      "timeout": 30000,
      "optional": true
    }
  ],

  "cleanup": [
    {
      "name": "remove-project",
      "command": "rm -rf /tmp/us-research-{{id}}-{{features_slug}}"
    }
  ],

  "changeable": [
    "packages/cli/src/generators/pear-desktop.ts",
    "packages/cli/src/generators/common.ts"
  ],

  "context": [
    "packages/agent-pack/src/skills/scaffold-project/SKILL.md",
    "packages/agent-pack/src/skills/setup-pear-desktop/SKILL.md",
    "packages/cli/src/generators/types.ts"
  ],

  "agent": {
    "instructions": "You are improving the `us` CLI scaffold generators for Pear Desktop apps. The generators in packages/cli/src/generators/ produce project files programmatically. Fix the generator code so all scaffold variants produce valid, working Pear Desktop projects. Reference the setup-pear-desktop skill for how a correct Pear project should look."
  },

  "maxIterations": 5
}
