{
  "id": "scaffold-node-cli",
  "name": "Node CLI Scaffold Validation",
  "description": "Verify that scaffolded Node.js CLI projects install, type-check, and run for all feature combinations",

  "build": {
    "command": "npx tsup src/us.ts --format esm && npm install -g .",
    "cwd": "packages/cli"
  },

  "output": "research/results/scaffold-node-cli",

  "variants": [
    {
      "name": "features",
      "values": ["bare", "p2p", "kv-storage", "qvac", "autobase", "p2p,qvac", "p2p,kv-storage", "p2p,kv-storage,qvac,autobase"]
    }
  ],

  "workDir": "/tmp/us-research-{{id}}-{{features_slug}}",

  "setup": [
    {
      "name": "clean",
      "command": "rm -rf /tmp/us-research-{{id}}-{{features_slug}}",
      "optional": true
    },
    {
      "name": "scaffold",
      "command": "us scaffold app -p node-cli -n test-node {{features_flag}} -o /tmp/us-research-{{id}}-{{features_slug}} --force",
      "timeout": 10000
    },
    {
      "name": "npm-install",
      "command": "npm install",
      "timeout": 120000
    }
  ],

  "measure": [
    {
      "name": "package-json-valid",
      "command": "node -e \"const p = require('./package.json'); if (!p.name || !p.scripts) throw new Error('invalid')\"",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "typecheck",
      "command": "npx tsc --noEmit",
      "timeout": 60000,
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "entry-exists",
      "command": "test -f src/index.ts",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "runtime-smoke",
      "mode": "spawn",
      "command": "npx tsx src/index.ts",
      "expectedOutput": ["Starting test-node...", "is running"],
      "timeout": 60000
    }
  ],

  "cleanup": [
    {
      "name": "remove-project",
      "command": "rm -rf /tmp/us-research-{{id}}-{{features_slug}}"
    }
  ],

  "changeable": [
    "packages/cli/src/generators/node-cli.ts",
    "packages/cli/src/generators/common.ts"
  ],

  "context": [
    "packages/agent-pack/src/skills/scaffold-project/SKILL.md",
    "packages/agent-pack/src/skills/setup-node-cli/SKILL.md",
    "packages/cli/src/generators/types.ts"
  ],

  "agent": {
    "instructions": "You are improving the `us` CLI scaffold generators for Node.js CLI apps. The generators in packages/cli/src/generators/ produce project files programmatically. Fix the generator code so all scaffold variants produce valid, working Node.js CLI projects that type-check and run."
  },

  "maxIterations": 5
}
