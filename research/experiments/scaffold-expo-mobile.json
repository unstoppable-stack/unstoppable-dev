{
  "id": "scaffold-expo-mobile",
  "name": "Expo Mobile Scaffold Validation",
  "description": "Verify that scaffolded Expo mobile projects install, prebuild, build for iOS/Android, and launch on simulator/emulator",

  "build": {
    "command": "npx tsup src/us.ts --format esm && npm install -g .",
    "cwd": "packages/cli"
  },

  "output": "research/results/scaffold-expo-mobile",

  "variants": [
    {
      "name": "features",
      "values": ["bare", "p2p", "qvac", "kv-storage", "p2p,qvac", "p2p,kv-storage", "p2p,kv-storage,qvac"]
    }
  ],

  "workDir": "/tmp/us-research-{{id}}-{{features_slug}}",

  "setup": [
    {
      "name": "clean",
      "command": "rm -rf /tmp/us-research-{{id}}-{{features_slug}}",
      "optional": true
    },
    {
      "name": "scaffold",
      "command": "us scaffold app -p expo-mobile -n test-mobile {{features_flag}} -o /tmp/us-research-{{id}}-{{features_slug}} --force",
      "timeout": 10000
    },
    {
      "name": "npm-install",
      "command": "npm install",
      "timeout": 180000
    }
  ],

  "measure": [
    {
      "name": "package-json-valid",
      "command": "node -e \"const p = require('./package.json'); if (!p.name || !p.scripts) throw new Error('invalid')\"",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "app-json-valid",
      "command": "node -e \"const a = require('./app.json'); if (!a.expo) throw new Error('missing expo')\"",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "metro-config-valid",
      "command": "node -e \"require('./metro.config.js')\"",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "expo-prebuild",
      "command": "npx expo prebuild --no-install",
      "timeout": 120000,
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "ios-dir-created",
      "command": "test -d ios",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "android-dir-created",
      "command": "test -d android",
      "successCriteria": { "type": "exit-code", "expected": 0 }
    },
    {
      "name": "ios-build",
      "command": "cd ios && xcodebuild -workspace *.xcworkspace -scheme testmobile -configuration Debug -sdk iphonesimulator -arch arm64 -derivedDataPath build build 2>&1 | tail -5",
      "timeout": 300000,
      "successCriteria": { "type": "stdout-contains", "pattern": "BUILD SUCCEEDED" }
    },
    {
      "name": "android-build",
      "command": "cd android && ./gradlew assembleDebug 2>&1 | tail -5",
      "timeout": 300000,
      "successCriteria": { "type": "stdout-contains", "pattern": "BUILD SUCCESSFUL" }
    },
    {
      "name": "metro-bundle-ios",
      "command": "npx expo export --platform ios --output-dir /tmp/us-export-test 2>&1 | tail -5",
      "timeout": 120000,
      "successCriteria": { "type": "exit-code", "expected": 0 }
    }
  ],

  "cleanup": [
    {
      "name": "remove-project",
      "command": "rm -rf /tmp/us-research-{{id}}-{{features_slug}}"
    }
  ],

  "changeable": [
    "packages/cli/src/generators/expo-mobile.ts",
    "packages/cli/src/generators/common.ts"
  ],

  "context": [
    "packages/agent-pack/src/skills/scaffold-project/SKILL.md",
    "packages/agent-pack/src/skills/setup-mobile-app/SKILL.md",
    "packages/agent-pack/src/recipes/qvac-mobile-expo.mdc",
    "packages/cli/src/generators/types.ts"
  ],

  "agent": {
    "instructions": "You are improving the `us` CLI scaffold generators for Expo Mobile apps. The generators in packages/cli/src/generators/ produce project files programmatically. Fix the generator code so all scaffold variants produce valid Expo projects that prebuild, build for iOS and Android, and launch. Reference the setup-mobile-app skill and qvac-mobile-expo recipe for how a correct Expo project should look."
  },

  "maxIterations": 5
}
