# electron-packager copies transitive file: dependencies as raw symlinks that
# point outside the .app, producing a broken bundle (and, on Linux, a deref
# copy that fills the disk). install-links makes npm materialize them as real
# directories instead.
#
# This lives here rather than on the command line because `npm ci` has to
# agree with the lockfile `npm install` wrote — a flag passed to only one of
# them puts them permanently out of sync.
install-links=true
