## Reference: Complete package.json for a Pear Desktop App with Worker

This is the minimal `package.json` for a Pear desktop app that uses a Bare
worker for P2P and/or AI operations:

```json
{
  "name": "my-app",
  "version": "0.1.0",
  "pear": {
    "name": "my-app",
    "type": "desktop",
    "pre": "pear-electron/pre",
    "routes": ".",
    "unrouted": [
      "/dist/worker/index.js"
    ],
    "gui": {
      "width": 1024,
      "height": 768,
      "minWidth": 600,
      "minHeight": 400,
      "backgroundColor": "#171817"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run build && concurrently \"npm:watch:src\" \"npm:watch:worker\" \"pear run -d .\"",
    "build": "bun run clean && bunx swc src -d dist --source-maps && bunx swc worker -d dist --source-maps",
    "watch:src": "bunx swc src -d dist --source-maps --watch --config-file .swcrc.dev",
    "watch:worker": "bunx swc worker -d dist --source-maps --watch",
    "clean": "rm -rf dist",
    "dev:local": "bun run build && concurrently \"npm:dht\" \"npm:watch:src\" \"npm:watch:worker\" \"pear run -d .\"",
    "dht": "node dht-bootstrap.js",
    "peer2": "bash test-peer2.sh",
    "stage": "bun run build && pear stage .",
    "seed": "pear seed .",
    "release": "pear release"
  },
  "dependencies": {
    "pear-electron": "^1.7.0",
    "pear-bridge": "^1.2.5",
    "pear-run": "^1.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.0",
    "@swc/core": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "chokidar": "^4.0.3",
    "concurrently": "^9.0.0",
    "pear-hotmods": "^1.0.0",
    "pear-interface": "^1.0.0",
    "react-refresh": "^0.17.0",
    "typescript": "^5.0.0"
  }
}
```

### Adding P2P (Hyperswarm + Protomux messaging):

```json
"dependencies": {
    "hyperswarm": "^4.17.0",
  "protomux": "^3.10.1",
    "compact-encoding": "^2.19.0",
    "b4a": "^1.8.0",
    "bare-process": "^4.3.0"
}
```

### Adding Storage (Corestore + Hyperbee):

```json
"dependencies": {
  "corestore": "^7.8.0",
    "hypercore": "^11.27.0",
  "hyperbee": "^2.27.3"
}
```

### Adding Dev Testing (local DHT bootstrap):

```json
"devDependencies": {
  "hyperdht": "^6.29.1"
}
```

### Adding AI (QVAC):

```json
"dependencies": {
  "@qvac/sdk": "^0.15.0",
  "zod": "^4.3.0"
},
"devDependencies": {
  "@qvac/cli": "^0.8.1"
}
```

`@qvac/sdk@0.15` no longer declares `@qvac/cli` as a peer dependency at all, so
the CLI installs cleanly — no `--legacy-peer-deps` workaround needed:

```bash
npm install -D '@qvac/cli@^0.8.1'
```

For Expo (mobile) apps additionally pin `react-native-bare-kit` to the exact
version that matches the SDK generation (`@qvac/sdk@0.15` declares it as an
optional `*` peer; we pin exact to keep the Bare runtime aligned with the
worker bundle):

```json
"dependencies": {
  "react-native-bare-kit": "0.15.0"
}
```
