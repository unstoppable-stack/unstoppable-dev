{
  "name": "@unstoppable/agent-pack",
  "version": "0.1.0",
  "description": "Portable stack workflows and local Codex/Claude plugin packages",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-research.js",
    "sync:dry": "node scripts/sync-research.js --dry-run",
    "convert-plugin": "node scripts/convert-to-plugin.mjs",
    "build:plugin": "node ../../scripts/sync-stack-assets.mjs && node scripts/build-plugin.mjs",
    "check:plugin": "node ../../scripts/sync-stack-assets.mjs --check && node scripts/build-plugin.mjs --check",
    "test:plugin": "node --test scripts/build-plugin.test.mjs",
    "test:plugin:hosts": "node scripts/smoke-plugin-hosts.mjs"
  },
  "keywords": [
    "unstoppable-stack",
    "cursor-plugin",
    "ai",
    "agent",
    "p2p",
    "holepunch",
    "qvac",
    "local-first"
  ],
  "license": "MIT"
}
