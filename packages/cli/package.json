{
  "name": "@unstoppable-stack/cli",
  "version": "0.4.0-beta.5",
  "description": "Configure AI-assistant workspaces and scaffold local-first P2P apps",
  "repository": {
    "type": "git",
    "url": "https://github.com/unstoppable-stack/unstoppable-dev.git",
    "directory": "packages/cli"
  },
  "homepage": "https://unstoppable-stack.dev",
  "type": "module",
  "bin": {
    "us": "./dist/us.js"
  },
  "files": [
    "dist",
    "templates",
    "agent-pack-src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/sync-stack-assets.mjs && tsup",
    "build:minimal": "node ../../scripts/sync-stack-assets.mjs && US_BUILD_PROFILE=minimal tsup",
    "build:full": "node ../../scripts/sync-stack-assets.mjs && US_BUILD_PROFILE=full tsup",
    "dev": "node ../../scripts/sync-stack-assets.mjs && US_BUILD_PROFILE=full tsup --watch",
    "prepack": "node ../../scripts/sync-stack-assets.mjs && US_BUILD_PROFILE=minimal tsup",
    "start": "node dist/us.js",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/sync-stack-assets.mjs --check && node ../../scripts/check-agent-pack.mjs && vitest run",
    "test:full": "pnpm build:full && vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/remote/__tests__/p2p-integration.test.ts",
    "test:e2e": "tsx e2e/test-scaffold.ts",
    "test:e2e:all": "QVAC_MOCK=1 tsx e2e/test-scaffold.ts --platform all",
    "test:e2e:all:full": "QVAC_MOCK=1 tsx e2e/test-scaffold.ts --platform all --level-expo-mobile 5",
    "test:e2e:mobile": "tsx e2e/test-scaffold.ts --platform expo-mobile",
    "test:e2e:mobile:mock": "QVAC_MOCK=1 tsx e2e/test-scaffold.ts --platform expo-mobile",
    "test:e2e:desktop": "tsx e2e/test-scaffold.ts --platform pear-desktop",
    "test:e2e:desktop:l5": "QVAC_MOCK=1 tsx e2e/test-scaffold.ts --platform pear-desktop --level 5",
    "test:e2e:desktop:qvac": "QVAC_REAL_E2E=1 tsx e2e/test-scaffold.ts --platform pear-desktop --level 5 --variant local-ai",
    "test:e2e:desktop:qvac:offline": "QVAC_REAL_E2E=1 QVAC_OFFLINE_E2E=1 tsx e2e/test-scaffold.ts --platform pear-desktop --level 5 --variant local-ai",
    "test:e2e:cli": "tsx e2e/test-scaffold.ts --platform node-cli",
    "test:e2e:smoke": "tsx e2e/test-scaffold.ts --platform node-cli --level 2",
    "test:e2e:ci": "QVAC_MOCK=1 tsx e2e/test-scaffold.ts --platform all --level-expo-mobile 2 --skip-variant expo-mobile/local-ai",
    "test:e2e:ci:desktop": "QVAC_MOCK=1 tsx e2e/test-scaffold.ts --platform pear-desktop --level 3",
    "test:e2e:ci:mobile": "QVAC_MOCK=1 tsx e2e/test-scaffold.ts --platform expo-mobile --level 2 --skip-variant expo-mobile/local-ai",
    "test:e2e:ci:cli": "QVAC_MOCK=1 tsx e2e/test-scaffold.ts --platform node-cli --level 3",
    "test:runtime": "node --test ../runtime-ai/test/*.test.js",
    "assets:check": "node ../../scripts/sync-stack-assets.mjs --check && node ../../scripts/check-agent-pack.mjs",
    "test:ui": "tsx e2e/test-ui-design.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@extractus/article-extractor": "^8.0.0",
    "@hyperswarm/testnet": "^3.1.4",
    "@mozilla/readability": "0.6.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.0.0",
    "b4a": "^1.8.0",
    "compact-encoding": "^2.19.0",
    "corestore": "^6.18.4",
    "duck-duck-scrape": "^2.2.5",
    "fastify": "^5.2.0",
    "fs-extra": "^11.2.0",
    "hyperbee": "^2.21.0",
    "hypercore": "^10.37.20",
    "hypercore-crypto": "^3.6.1",
    "hyperdht": "^6.29.4",
    "hyperdrive": "^11.12.0",
    "hyperswarm": "^4.17.0",
    "jsdom": "^26.0.0",
    "node-pty": "1.0.0",
    "playwright": "^1.59.1",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "unstoppable",
    "p2p",
    "holepunch",
    "pear",
    "hypercore",
    "qvac",
    "local-first",
    "scaffolding",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
