{
  "name": "@unstoppable-stack/cli",
  "version": "0.2.0",
  "description": "The Unstoppable Stack CLI (us) — scaffold, research, and doctor P2P apps",
  "type": "module",
  "bin": {
    "us": "./dist/us.js"
  },
  "files": [
    "dist",
    "templates",
    "agent-pack-src"
  ],
  "scripts": {
    "build": "tsup",
    "build:minimal": "US_BUILD_PROFILE=minimal tsup",
    "build:full": "US_BUILD_PROFILE=full tsup",
    "dev": "US_BUILD_PROFILE=full tsup --watch",
    "prepack": "US_BUILD_PROFILE=minimal tsup",
    "start": "node dist/us.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:full": "pnpm build:full && vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/remote/__tests__/p2p-integration.test.ts",
    "test:e2e": "npx tsx e2e/test-scaffold.ts",
    "test:e2e:all": "QVAC_MOCK=1 npx tsx e2e/test-scaffold.ts --platform all",
    "test:e2e:all:full": "QVAC_MOCK=1 npx tsx e2e/test-scaffold.ts --platform all --level-expo-mobile 5",
    "test:e2e:mobile": "npx tsx e2e/test-scaffold.ts --platform expo-mobile",
    "test:e2e:mobile:mock": "QVAC_MOCK=1 npx tsx e2e/test-scaffold.ts --platform expo-mobile",
    "test:e2e:desktop": "npx tsx e2e/test-scaffold.ts --platform pear-desktop",
    "test:e2e:desktop:l5": "QVAC_MOCK=1 npx tsx e2e/test-scaffold.ts --platform pear-desktop --level 5",
    "test:e2e:cli": "npx tsx e2e/test-scaffold.ts --platform node-cli",
    "test:e2e:smoke": "npx tsx e2e/test-scaffold.ts --platform node-cli --level 2",
    "test:e2e:ci": "QVAC_MOCK=1 npx tsx e2e/test-scaffold.ts --platform all --level-expo-mobile 2 --skip-variant expo-mobile/local-ai",
    "test:e2e:ci:desktop": "QVAC_MOCK=1 npx tsx e2e/test-scaffold.ts --platform pear-desktop --level 3",
    "test:e2e:ci:mobile": "QVAC_MOCK=1 npx tsx e2e/test-scaffold.ts --platform expo-mobile --level 2 --skip-variant expo-mobile/local-ai",
    "test:e2e:ci:cli": "QVAC_MOCK=1 npx tsx e2e/test-scaffold.ts --platform node-cli --level 3"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.0.0",
    "@hyperswarm/testnet": "^3.1.4",
    "@mozilla/readability": "^0.5.0",
    "b4a": "^1.8.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "compact-encoding": "^2.19.0",
    "corestore": "^6.18.4",
    "duck-duck-scrape": "^2.2.5",
    "fastify": "^5.2.0",
    "fs-extra": "^11.2.0",
    "hyperbee": "^2.21.0",
    "hypercore": "^10.37.20",
    "hypercore-crypto": "^3.6.1",
    "hyperdht": "^6.29.4",
    "hyperdrive": "^11.12.0",
    "hyperswarm": "^4.17.0",
    "inquirer": "^9.2.0",
    "jsdom": "^26.0.0",
    "node-pty": "1.0.0",
    "ora": "^8.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.0.0",
    "playwright": "^1.59.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "unstoppable",
    "p2p",
    "holepunch",
    "pear",
    "hypercore",
    "qvac",
    "local-first",
    "scaffolding",
    "cli"
  ],
  "license": "MIT"
}
