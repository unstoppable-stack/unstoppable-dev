    "path": "app/index.tsx",
  },
  {
    "content": "iVBORw0KGgoAAAANSUhEUgAAACAAAAAgCAYAAABzenr0AAAAMElEQVR42u3OIQEAAAgDMDQByED/ghDjZmJ+1bOXVAICAgICAgICAgICAgICAunAA1fSHEzA5mfcAAAAAElFTkSuQmCC",
    "path": "assets/icon.png",
