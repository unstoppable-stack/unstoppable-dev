    "content": "# snap-test

Built with the **Unstoppable Stack** — P2P, local-first, no servers.

## Platform

Node.js CLI

## Features

- **P2P Networking** — Hyperswarm for peer discovery and connections
- **KV Storage** — Hyperbee for persistent local key-value data
- **Local AI** — QVAC SDK for offline inference with streaming chat

## Getting Started

\`\`\`bash
npm install
npm run dev
\`\`\`

## Project Structure

See \`planning/\` for architecture decisions and feature plans.
",
    "path": "README.md",
  },
  {
    "content": "/**
 * AI manager using QVAC SDK.
 *
 * Set QVAC_MOCK=1 in the environment to use a stub implementation that
 * echoes input back — useful for E2E tests where loading a real model
 * is impractical.
 */

// The SDK is imported lazily, inside setupAI(), rather than at module
// scope. A top-level import runs the SDK's native-module resolution as a
// side effect of loading this file, so an SDK problem takes down the whole
// CLI before it can print anything useful. Deferring it keeps the failure
// local to AI setup and keeps mock mode free of any SDK dependency.
type QvacSdk = typeof import('@qvac/sdk')

const MOCK_MODE = process.env.QVAC_MOCK === '1'
const CTX_SIZE = 4096

let modelId: string | null = null
let sdk: QvacSdk | null = null

export async function setupAI() {
  if (MOCK_MODE) {
    console.log('AI mock mode enabled — skipping model load')
    modelId = 'mock-model'
    return {
      async chat(message: string) {
        return {
          async *tokenStream() {
            const reply = \`Mock: \${message}\`
            for (const ch of reply) {
              yield ch
              await new Promise((r) => setTimeout(r, 5))
            }
          },
        }
      },
      async cleanup() {
        modelId = null
      },
    }
  }

  sdk = await import('@qvac/sdk')
  const { loadModel, QWEN3_5_0_8B_MULTIMODAL_Q4_K_M } = sdk

  console.log('Loading AI model (Qwen 3.5 0.8B, ~532MB on first run)...')
  modelId = await loadModel({
    modelSrc: QWEN3_5_0_8B_MULTIMODAL_Q4_K_M,
    modelType: 'llm',
    modelConfig: {
      ctx_size: CTX_SIZE,
      // Sliding window — evict oldest ~10% on overflow instead of throwing.
      n_discarded: Math.floor(CTX_SIZE / 10),
      // 0 = no reasoning, -1 = unlimited. Engine-level, so no prompt hacks
      // and no stripping reasoning blocks back out of the token stream.
      reasoning_budget: 0,
      system_prompt: 'You are a helpful assistant.',
    },
    onProgress: (progress: any) => {
      if (progress.percentage) {
        process.stdout.write(
          \`\\rDownloading model: \${Math.round(progress.percentage)}%\`,
        )
      }
    },
  })
  console.log('\\nModel loaded:', modelId)

  return {
    async chat(message: string) {
      if (!modelId || !sdk) throw new Error('Model not loaded')
      const result = sdk.completion({
        modelId,
        history: [{ role: 'user', content: message }],
        stream: true,
      })
      return result
    },

    /** Stop an in-flight completion. Safe to call when nothing is running. */
    async abort() {
      if (!modelId || !sdk) return
      await sdk.cancel({ operation: 'inference', modelId })
    },

    async cleanup() {
      if (modelId && modelId !== 'mock-model' && sdk) {
        await sdk.unloadModel({ modelId })
      }
      modelId = null
    },
  }
}
",
    "path": "src/ai-manager.ts",
  },
  {
    "content": "import Corestore from 'corestore'
import { createSwarm } from './swarm-manager.js'
import { createStorage } from './storage-manager.js'
import { setupAI } from './ai-manager.js'

async function main() {
  console.log('Starting snap-test...')

  const store = new Corestore('./storage')
  const swarm = createSwarm(store)
  console.log('P2P swarm started')
  const db = await createStorage(store)
  console.log('Storage ready')
  const ai = await setupAI()
  console.log('AI ready')

  console.log('snap-test is running. Press Ctrl+C to exit.')

  process.on('SIGINT', async () => {
    console.log('\\nShutting down...')
    await swarm.destroy()
    await ai.cleanup()
    process.exit(0)
  })
}

main().catch((err) => {
  console.error('Fatal error:', err)
  process.exit(1)
})
