    "content": "# Planning

Architecture decisions, feature plans, and project documentation.

## What Goes Here

- **Architecture decisions** — Record important technical choices
- **Feature plans** — Break down features before implementing
- **Design docs** — Document system design and data flows
",
    "path": "planning/README.md",
  },
  {
    "content": "# snap-test

Built with the **Unstoppable Stack** — P2P, local-first, no servers.

## Platform

Pear Desktop

## Features

- **P2P Networking** — Hyperswarm for peer discovery and connections
- **KV Storage** — Hyperbee for persistent local key-value data
- **Node Sync** — Replicate data to the Unstoppable Node for backup + seeding

## Getting Started

\`\`\`bash
npm install
npm run dev
\`\`\`

## Connecting to the Unstoppable Node

This app registers its data with a local Unstoppable Node for P2P
replication and backup. To enable sync, run the node in a separate
terminal:

\`\`\`bash
npx unstoppable-node
\`\`\`

The app will attempt to pair automatically on startup and keep working
regardless of whether the Node is running.

## Project Structure

See \`planning/\` for architecture decisions and feature plans.
",
    "path": "README.md",
  },
  {
    "content": "/* global Bare */
import Corestore from 'corestore'
import Hyperswarm from 'hyperswarm'
import Hyperbee from 'hyperbee'
import crypto from 'hypercore-crypto'
import { connectToNode } from '@unstoppable-stack/node-client'

const pipe = Bare.IPC
const storagePath = Bare.argv[2]

// Module-scope state (populated during init, used by handleCommand + cleanup)
let store = null
let swarm = null
let db = null
let nodeClient = null

function send(msg) {
  pipe.write(JSON.stringify(msg) + '\\n')
}

let buffer = ''
pipe.on('data', (data) => {
  buffer += data.toString()
  const lines = buffer.split('\\n')
  buffer = lines.pop() || ''
  for (const line of lines) {
    if (!line.trim()) continue
    handleCommand(JSON.parse(line))
  }
})

async function handleCommand(msg) {
  switch (msg.type) {
    case 'join-topic': {
      const topic = crypto.discoveryKey(Buffer.from(msg.topic))
      swarm.join(topic, { server: true, client: true })
      send({ type: 'joined', topic: msg.topic })
      break
    }
    case 'db-put': {
      await db.put(msg.key, msg.value)
      send({ type: 'db-put-ok', key: msg.key })
      break
    }
    case 'db-get': {
      const entry = await db.get(msg.key)
      send({ type: 'db-get-ok', key: msg.key, value: entry?.value ?? null })
      break
    }
    case 'shutdown':
      await cleanup()
      break
    default:
      send({ type: 'error', error: \`Unknown command: \${msg.type}\` })
  }
}

async function cleanup() {
  if (swarm) await swarm.destroy()
  if (db) await db.close()
  if (store) await store.close()
  if (nodeClient) await nodeClient.close()
  Bare.exit()
}

send({ type: 'workerReady' })

async function init() {
  store = new Corestore(storagePath)

  swarm = new Hyperswarm()
  swarm.on('connection', (conn) => {
    store.replicate(conn)
    conn.on('error', () => {})
  })
  send({ type: 'status', service: 'p2p', status: 'ready' })

  const core = store.get({ name: 'main-db' })
  db = new Hyperbee(core, { keyEncoding: 'utf-8', valueEncoding: 'json' })
  await db.ready()
  send({ type: 'status', service: 'storage', status: 'ready' })

  send({ type: 'status', service: 'node-sync', status: 'searching' })
  try {
    nodeClient = await connectToNode({
      appId: 'snap-test',
      appName: 'snap-test',
      cores: [{ key: db.core.key, type: 'hyperbee', name: 'main-db' }],
      timeout: 5_000,
      reconnect: true
    })
    send({ type: 'status', service: 'node-sync', status: 'connected' })
    nodeClient.on('disconnected', () => {
      send({ type: 'status', service: 'node-sync', status: 'disconnected' })
    })
    nodeClient.on('reconnecting', () => {
      send({ type: 'status', service: 'node-sync', status: 'reconnecting' })
    })
    nodeClient.on('reconnected', () => {
      send({ type: 'status', service: 'node-sync', status: 'connected' })
    })
    nodeClient.on('reconnectFailed', () => {
      send({ type: 'status', service: 'node-sync', status: 'unavailable' })
    })
  } catch (err) {
    send({ type: 'status', service: 'node-sync', status: 'unavailable', error: err.message })
  }
  send({ type: 'init-complete' })
}

init().catch((err) => send({ type: 'fatal', error: err.message }))
",
    "path": "worker.js",
  },
]
`;

exports[`generator snapshots > pear-desktop > wallet: file tree matches snapshot 1`] = `
