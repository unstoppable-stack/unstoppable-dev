import { setupNodeSync } from './node-sync.js'

async function main() {
  console.log('Starting snap-test...')

  const store = new Corestore('./storage')
  const swarm = createSwarm(store)
  console.log('P2P swarm started')
  const db = await createStorage(store)
  console.log('Storage ready')
  const nodeSync = setupNodeSync({ db })

  console.log('snap-test is running. Press Ctrl+C to exit.')

  process.on('SIGINT', async () => {
    console.log('\\nShutting down...')
    await swarm.destroy()
    await nodeSync.close()
