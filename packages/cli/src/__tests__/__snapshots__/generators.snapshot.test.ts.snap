  {
    "content": "# snap-test

Built with the **Unstoppable Stack** — P2P, local-first, no servers.

## Platform

Pear Desktop

## Features

- **P2P Networking** — Hyperswarm for peer discovery and connections
- **KV Storage** — Hyperbee for persistent local key-value data

## Getting Started

\`\`\`bash
npm install
npm run dev
\`\`\`

## Project Structure

See \`planning/\` for architecture decisions and feature plans.
",
    "path": "README.md",
  },
  {
    "content": "/* global Pear */
import Corestore from 'corestore'
import Hyperswarm from 'hyperswarm'
import Hyperbee from 'hyperbee'
import crypto from 'hypercore-crypto'

const pipe = Pear.worker.pipe()
const storagePath = Pear.config.storage

// Module-scope state (populated during init, used by handleCommand + cleanup)
let store = null
let swarm = null
let db = null

function send(msg) {
  pipe.write(JSON.stringify(msg) + '\\n')
}

let buffer = ''
pipe.on('data', (data) => {
  buffer += data.toString()
  const lines = buffer.split('\\n')
  buffer = lines.pop() || ''
  for (const line of lines) {
    if (!line.trim()) continue
    handleCommand(JSON.parse(line))
  }
})

async function handleCommand(msg) {
  switch (msg.type) {
    case 'join-topic': {
      const topic = crypto.discoveryKey(Buffer.from(msg.topic))
      swarm.join(topic, { server: true, client: true })
      send({ type: 'joined', topic: msg.topic })
      break
    }
    case 'db-put': {
      await db.put(msg.key, msg.value)
      send({ type: 'db-put-ok', key: msg.key })
      break
    }
    case 'db-get': {
      const entry = await db.get(msg.key)
      send({ type: 'db-get-ok', key: msg.key, value: entry?.value ?? null })
      break
    }
    case 'shutdown':
      await cleanup()
      break
    default:
      send({ type: 'error', error: \`Unknown command: \${msg.type}\` })
  }
}

async function cleanup() {
  if (swarm) await swarm.destroy()
  Pear.exit()
}

send({ type: 'workerReady' })

async function init() {
  store = new Corestore(storagePath)

  swarm = new Hyperswarm()
  swarm.on('connection', (conn) => {
    store.replicate(conn)
    conn.on('error', () => {})
  })
  send({ type: 'status', service: 'p2p', status: 'ready' })

  const core = store.get({ name: 'main-db' })
  db = new Hyperbee(core, { keyEncoding: 'utf-8', valueEncoding: 'json' })
  await db.ready()
  send({ type: 'status', service: 'storage', status: 'ready' })
  send({ type: 'init-complete' })
}

init().catch((err) => send({ type: 'fatal', error: err.message }))
",
    "path": "worker.js",
  },
]
`;

exports[`generator snapshots > pear-desktop > local-ai+wallet: file tree matches snapshot 1`] = `
[
