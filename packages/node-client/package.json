{
  "name": "@unstoppable-stack/node-client",
  "version": "0.4.0",
  "description": "Client library to connect Unstoppable Stack apps to the Node for data replication and sync",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./errors": "./src/errors.js",
    "./protocol": "./src/protocol.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "p2p",
    "hyperswarm",
    "unstoppable-stack",
    "node-client",
    "local-first",
    "qvac"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/unstoppable-stack/unstoppable-stack.git",
    "directory": "packages/node-client"
  },
  "homepage": "https://unstoppable.dev",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.js",
    "prepublishOnly": "npm test && npm pack --dry-run"
  },
  "dependencies": {
    "b4a": "^1.8.0",
    "bare-events": "^2.8.3",
    "hypercore-crypto": "^3.6.0",
    "hyperswarm": "^4.17.0"
  },
  "optionalDependencies": {
    "bare-env": "^3.0.0",
    "bare-os": "^3.6.1"
  },
  "license": "MIT"
}
