{
  "name": "@unstoppable-stack/p2p",
  "version": "0.6.0-alpha.4",
  "description": "P2P identity, pairing, capability calls, streaming and optional data/file replication",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./errors": "./src/errors.js",
    "./protocol": "./src/protocol.js",
    "./sync": "./src/sync/index.js",
    "./sync/replication": "./src/sync/replication.js",
    "./sync/resource-manifest": "./src/sync/resource-manifest.js",
    "./rpc": {
      "types": "./src/rpc.d.ts",
      "default": "./src/rpc.js"
    },
    "./db": {
      "types": "./src/db/index.d.ts",
      "default": "./src/db/index.js"
    },
    "./service": {
      "types": "./src/service.d.ts",
      "default": "./src/service.js"
    },
    "./data": {
      "types": "./src/data.d.ts",
      "default": "./src/data.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs",
    "scripts/smoke-bare.mjs",
    "scripts/run-bare-smoke.mjs"
  ],
  "keywords": [
    "p2p",
    "hyperswarm",
    "protomux",
    "unstoppable-stack",
    "local-first",
    "capabilities"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/unstoppable-stack/unstoppable-dev.git",
    "directory": "packages/p2p"
  },
  "homepage": "https://unstoppable-stack.dev",
  "engines": {
    "node": ">=20",
    "bare": ">=1.32.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "test": "node --test --test-force-exit --test-timeout 120000 test/*.test.js test/sync/*.test.js test/db/*.test.js",
    "test:unit": "node --test test/capabilities.test.js test/identity.test.js test/registry.test.js",
    "test:integration": "node --test --test-force-exit test/pairing.test.js",
    "test:bare": "node scripts/run-bare-smoke.mjs",
    "test:types": "tsc --noEmit --project test/types/tsconfig.json"
  },
  "dependencies": {
    "b4a": "^1.9.0",
    "bare-events": "^2.9.2",
    "bare-fs": "^4.8.4",
    "bare-path": "^3.1.2",
    "compact-encoding": "^2.16.0",
    "corestore": "^7.8.0",
    "fd-lock": "^2.2.0",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.27.0",
    "hypercore-crypto": "^3.6.0",
    "hyperdrive": "^12.3.0",
    "hyperswarm": "^4.17.2",
    "protomux": "^3.13.0"
  },
  "optionalDependencies": {
    "bare-env": "^3.0.0",
    "bare-os": "^3.6.1"
  },
  "devDependencies": {
    "autobase": "7.28.2",
    "hyperdht": "^6.34.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "types": "./src/index.d.ts",
  "peerDependencies": {
    "autobase": "7.28.2"
  },
  "peerDependenciesMeta": {
    "autobase": {
      "optional": true
    }
  }
}
