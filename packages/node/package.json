{
  "name": "unstoppable-node",
  "version": "0.6.0-alpha.1",
  "description": "Personal Node for Unstoppable Stack apps \u2014 replicates, backs up, and seeds your P2P data",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./personal-node": "./src/personal-node.js",
    "./config": "./src/config.js",
    "./export": "./src/export.js"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "p2p",
    "hyperswarm",
    "hypercore",
    "hyperbee",
    "hyperdrive",
    "unstoppable-stack",
    "local-first",
    "qvac"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/unstoppable-stack/unstoppable-dev.git",
    "directory": "packages/node"
  },
  "homepage": "https://unstoppable.dev",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "unstoppable-node": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 --test-force-exit --test-timeout 120000 test/*.test.js",
    "test:unit": "node --test test/config.test.js test/export.test.js",
    "prepublishOnly": "npm test && npm pack --dry-run"
  },
  "dependencies": {
    "@unstoppable-stack/node-core": "file:../node-core",
    "@unstoppable-stack/node-caps-sync": "file:../node-caps-sync",
    "@unstoppable-stack/node-caps-ai": "file:../node-caps-ai",
    "b4a": "^1.8.0",
    "bare-events": "^2.8.3",
    "bare-fs": "^4.5.5",
    "bare-path": "^3.0.0",
    "chalk": "^5.3.0"
  },
  "optionalDependencies": {
    "bare-env": "^3.0.0",
    "bare-os": "^3.6.1"
  },
  "license": "MIT",
  "devDependencies": {
    "hyperdht": "^6.29.1",
    "corestore": "^7.8.0",
    "hyperbee": "^2.27.3",
    "hyperdrive": "^12.3.0",
    "hyperswarm": "^4.17.0"
  }
}
