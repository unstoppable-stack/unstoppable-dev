{
  "name": "unstoppable-node",
  "version": "0.4.0",
  "description": "Personal sync node for Unstoppable Stack apps — replicates, backs up, and seeds your P2P data",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./ai-provider": "./src/ai-provider.js",
    "./config": "./src/config.js",
    "./export": "./src/export.js",
    "./registry": "./src/registry.js",
    "./replication": "./src/replication.js",
    "./protocol": "./src/protocol.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "p2p",
    "hyperswarm",
    "hypercore",
    "hyperbee",
    "hyperdrive",
    "unstoppable-stack",
    "local-first",
    "qvac"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/unstoppable-stack/unstoppable-stack.git",
    "directory": "packages/node"
  },
  "homepage": "https://unstoppable.dev",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "unstoppable-node": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 --test-force-exit test/*.test.js",
    "test:unit": "node --test test/protocol.test.js test/registry.test.js",
    "test:integration": "node --test --test-force-exit test/pairing.test.js test/replication.test.js",
    "test:edge": "node --test --test-force-exit test/edge-cases.test.js",
    "test:e2e": "node --test --test-force-exit --test-timeout 120000 test/e2e/e2e.test.js",
    "test:qvac": "RUN_QVAC_E2E=1 node --test --test-force-exit --test-timeout 300000 test/ai-provider-real.test.js",
    "test:all": "node --test --test-concurrency=1 --test-force-exit --test-timeout 120000 test/*.test.js test/e2e/e2e.test.js",
    "prepublishOnly": "npm test && npm pack --dry-run"
  },
  "dependencies": {
    "b4a": "^1.8.0",
    "bare-events": "^2.8.3",
    "chalk": "^5.3.0",
    "corestore": "^7.8.0",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.27.0",
    "hypercore-crypto": "^3.6.0",
    "hyperdrive": "^12.3.0",
    "hyperswarm": "^4.17.0"
  },
  "optionalDependencies": {
    "bare-env": "^3.0.0",
    "bare-os": "^3.6.1"
  },
  "license": "MIT",
  "devDependencies": {
    "hyperdht": "^6.29.1"
  }
}
