{
  "name": "unstoppable-node",
  "version": "0.6.0-alpha.2",
  "description": "Personal Node for Unstoppable Stack apps — replicates and seeds declared P2P data",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./personal-node": "./src/personal-node.js",
    "./config": "./src/config.js",
    "./export": "./src/export.js",
    "./internal/ai": "./src/ai/index.js",
    "./internal/qvac-runtime": "./src/ai/qvac-runtime.js"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "p2p",
    "hyperswarm",
    "hypercore",
    "hyperbee",
    "hyperdrive",
    "unstoppable-stack",
    "local-first",
    "qvac"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/unstoppable-stack/unstoppable-dev.git",
    "directory": "packages/node"
  },
  "homepage": "https://unstoppable-stack.dev",
  "engines": {
    "node": ">=22.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "unstoppable-node": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 --test-force-exit --test-timeout 120000 test/*.test.js",
    "test:unit": "node --test test/config.test.js test/export.test.js",
    "prepublishOnly": "npm test && npm pack --dry-run",
    "test:qvac": "node --test --test-force-exit --test-timeout 3000000 test/ai-provider-real.test.js"
  },
  "dependencies": {
    "@unstoppable-stack/p2p": "file:../p2p",
    "b4a": "^1.8.0",
    "bare-events": "^2.9.2",
    "bare-fs": "^4.8.2",
    "bare-path": "^3.0.0",
    "chalk": "^5.3.0"
  },
  "optionalDependencies": {
    "bare-env": "^3.0.0",
    "bare-os": "^3.6.1"
  },
  "license": "MIT",
  "devDependencies": {
    "corestore": "^7.13.0",
    "hyperbee": "^2.27.3",
    "hyperdht": "^6.34.1",
    "hyperdrive": "^12.3.0",
    "hyperswarm": "^4.17.2"
  }
}
