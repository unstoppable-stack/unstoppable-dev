{
  "name": "unstoppable-memory-desktop",
  "version": "0.1.0",
  "description": "Pear Desktop companion app for local-first Unstoppable Memory",
  "type": "module",
  "private": true,
  "pear": {
    "name": "unstoppable-memory-desktop",
    "type": "desktop",
    "pre": "pear-electron/pre",
    "routes": ".",
    "unrouted": ["/worker.js"],
    "gui": {
      "backgroundColor": "#0d1117",
      "closeHides": true,
      "height": 760,
      "width": 1120
    }
  },
  "scripts": {
    "dev": "pear run -d .",
    "test": "node --test --test-force-exit test/*.test.js",
    "test:smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@unstoppable/memory": "file:../memory",
    "@unstoppable/memory-client": "file:../memory-client",
    "@unstoppable/memory-mcp": "file:../memory-mcp",
    "@unstoppable-stack/node-client": "file:../node-client",
    "pear-bridge": "^1.2.4",
    "pear-electron": "^1.7.0",
    "pear-pipe": "^1.0.6",
    "pear-run": "^1.0.7"
  }
}
